{
  "name": "@mcpforge/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCPForge portal — Next.js App Router shell (W0-J2) plus the design-tokens package (W0-J1).",
  "exports": {
    "./design/tokens": "./src/design/tokens.ts"
  },
  "scripts": {
    "build-tokens": "tsx src/design/build-tokens.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y:contrast": "vitest run src/design/contrast.test.ts",
    "test:a11y:components": "vitest run src/components",
    "playwright:install": "playwright install chromium",
    "test:a11y:routes": "playwright test tests/a11y/axe-routes.spec.ts",
    "test:a11y:keyboard": "playwright test tests/a11y/keyboard --workers=2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.11.3",
    "@codemirror/lint": "6.8.5",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@lezer/highlight": "1.2.3",
    "@hookform/resolvers": "^5.9.1",
    "@mcpforge/cli": "workspace:*",
    "@mcpforge/codegen": "workspace:*",
    "@mcpforge/registry": "workspace:*",
    "@mcpforge/shared": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.11",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "codemirror": "6.0.2",
    "lucide-react": "^1.42.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "yaml": "2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@mcpforge/gateway": "workspace:*",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
